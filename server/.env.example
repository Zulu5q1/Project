# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/unixchange?schema=public"

# Authentication (for future use)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Development Admin Seed (development only — do not use real credentials)
ADMIN_EMAIL=admin@unixchange.com
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Development Student Seed (development only)
STUDENT_EMAIL=student@unixchange.com
STUDENT_PASSWORD=student123
STUDENT_USERNAME=student

# Image Storage — Cloudinary (required for image uploads in production)
# In development, provide image URLs directly when creating listings.
# For production uploads, configure these variables:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
